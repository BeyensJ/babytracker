{
  "name": "Baby Tracker",
  "short_name": "Baby Tracker",
  "description": "Serene baby care tracking for feeding, sleep, diapers, growth, and real-time family sync.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FAF7F2",
  "theme_color": "#FAF7F2",
  "categories": ["lifestyle", "health", "parenting"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nursing Timer",
      "short_name": "Nurse",
      "description": "Start breastfeeding timer",
      "url": "/#nurse",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sleep Timer",
      "short_name": "Sleep",
      "description": "Start sleep timer",
      "url": "/#sleep",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log Diaper",
      "short_name": "Diaper",
      "description": "Record a diaper change",
      "url": "/#diaper",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
